{
  "name": "eaglercraft-meteor-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime-agnostic Meteor-inspired client framework (module system, settings, ClickGUI, HUD) intended to be injected into the Eaglercraft 26.2-u1 client HTML.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:eagler": "node tools/inject-eaglercraft.mjs",
    "build:native": "node native-bridge/build-native-client.mjs",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "test:integration": "node --test --test-force-exit tests/eaglercraft-integration.test.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "smoke": "node tools/smoke.mjs",
    "docs:modules": "node tools/gen-docs.mjs",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.64.1"
  }
}
